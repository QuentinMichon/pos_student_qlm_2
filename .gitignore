# Ignore all generated files :
*.[oa]
*.cmd
*.tmp*
*.log
*.ko
*.mk
*.builtin
*.dtb
*.su
*.itb

**/doxy/**
**/generated/**
**/optee_os/out/**

**/build

# The top-level infrabase metadata tree (/build) is matched by **/build above,
# which used to force recipe sources (patches, .bb/.inc, conf) to be added with
# `git add -f` — easy to forget, and a forgotten patch breaks CI parsing. Un-ignore
# /build, re-ignore everything one level under it, then re-include only the source
# dirs. Build output stays ignored: build/tmp (also build/.gitignore), build/cache,
# build/bitbake.lock, logs/artifacts (*.log, *.o, *.dtb, *.itb, ... from the rules
# above). Nested build/ dirs elsewhere (optee_os, agency, avz) remain ignored.
!/build/
/build/*
!/build/conf/
!/build/meta-*/
# The core layer has NO dash, so "meta-*" above does not match it: its classes
# (base, patch, utils, logging, terminal) and conf/ were tracked only because
# they predate the rule, and any file added there since would have been ignored
# in silence — a new class simply never reaching the repository.
!/build/meta/

# Per-machine bitbake overrides (see build/meta/conf/bitbake.conf). The rules
# just above re-include all of build/conf/, so this one file needs its own.
# The TEZI feed published by deploy.sh lives in build/deploy/ (along with the
# feed server's pid/log) and is already covered by the /build/* rule.
/build/conf/site.conf

# The rpi4 BSP deploys Broadcom's prebuilt bcm27xx device trees onto the boot
# partition, alongside start4.elf & co. Unlike every other .dtb in the tree they
# are vendored *inputs*, not build products, so the "*.dtb" rule above must not
# apply: it silently swallowed them when the vendored bsp/rpi4 tree was replaced
# by this recipe directory, leaving the deploy with no device tree to install
# and a fresh card unbootable (the firmware finds none, and U-Boot takes its own
# DT from the firmware — CONFIG_OF_BOARD). Same shape as the /atf and /qemu
# anchoring notes below.
!/build/meta-bsp/recipes-bsp/bsp/rpi4/*.dtb

# The fetched ATF source tree lives at the repo root (/atf), like /u-boot, /avz,
# qemu. Anchor to /atf so the bare name doesn't also match the meta-atf recipe
# directory (build/meta-atf/recipes-atf/atf), which holds tracked recipe sources.
/atf/
#vmlinux*
uImage*
domains*
modules.order
vmlinux.*dom*
**/include/config/**

# The QEMU source tree fetched by build.sh lives at the repo root (/qemu), like
# /atf and /u-boot. Anchor to /qemu so the bare name doesn't also match the
# meta-qemu recipe directory (build/meta-qemu/recipes-qemu/qemu), which holds
# tracked recipe sources and patches.
/qemu

# SO3 is no longer vendored here: the so3 recipe fetches it from github, pins it
# to a release tag and applies the course patch set (meta-so3/recipes-so3/vext)
# on top, so /so3 is a generated tree like /u-boot and /qemu — edit the patch
# set, not the tree (do_attach_infrabase guards it with so3.attach.sha256).
# Anchored for the same reason as /qemu above: a bare "so3" would also swallow
# build/meta-so3/recipes-so3/so3 and .../vext, i.e. the recipe and the patch set
# themselves.
/so3/
/so3.attach.sha256
/so3.back/

# Backup files
*~

# Hidden files
.*

# Eclipse stuff
*.launch

agency/rootfs/build/**
agency/rootfs/host/**
agency/rootfs/images/**
agency/rootfs/target/**


# except the followings:
#Don't ignore the ignore file ;-)
!.gitignore
!.github
#TaMPLate files for the man documentation
!*.tmpl
!.clang-format
!buildroot/**
!buildroot/docs/manual/*.mk
!agency/rootfs/*.mk
!agency/rootfs/package/**
!agency/rootfs/board/**/*.d

*asm-offsets.s
# SO3 sources are now nested under so3/ (so3/so3 = kernel, so3/usr, so3/rootfs, so3/target)
so3/so3/so3
so3/so3/so3.bin
so3/usr/lib/libc/include/asm
so3/rootfs/rootfs.fat
# The lvgl/slv integration is a PRODUCTION of the :lvgl override (meta-usr lvgl
# bbappend): lvgl is fetched, and the 19 creation patches generate lib/slv,
# lib/lv_conf.h and the src/{fillfb,lvgl_*} apps into the tree; so3/usr/patches/
# is the quilt staging dir left by do_patch. None of these are source — the
# source of truth is build/meta-usr/recipes-usr/lvgl/files/0001-usr-so3-1.0-r0/.
so3/usr/lib/lvgl/
so3/usr/lib/slv/
so3/usr/lib/lv_conf.h
so3/usr/src/fillfb.c
so3/usr/src/lvgl_demo.c
so3/usr/src/lvgl_perf.c
so3/usr/src/lvgl_benchmark.c
so3/usr/src/lvgl_widgets.c
so3/usr/patches/
# The whole linux/ tree is a build working area, not committed: linux/linux
# is the fetched agency kernel, linux/usr is regenerated from the meta-usr
# patch set (base + :soo), linux/images holds rendered ITS + .itb output.
# (so3/ differs: its kernel so3/so3 IS tracked in-tree.)
/linux/
# ITB build output (rendered ITS + .itb); ITS sources live in meta-bsp/recipes-bsp/*/files/its
so3/images/
so3/so3/scripts/basic/fixdep
so3/so3/scripts/dtc/dtc
so3/so3/scripts/kconfig/conf
so3/so3/scripts/kconfig/lex.zconf.c
so3/so3/scripts/kconfig/zconf.hash.c
so3/so3/scripts/kconfig/zconf.tab.c

# AVZ out-of-tree (O=) build dir — only the script + readme are tracked,
# everything else is generated by `build.sh -x avz`.
/avz/*
!/avz/build.sh
!/avz/README.md

# u-boot is FETCHED (meta-uboot recipe: github 2022.04 @ pinned SRCREV +
# the SO3 patch set), like qemu/avz — not kept in-tree. The build attaches
# the fetched tree here (backing any prior copy up to u-boot.back).
/u-boot/

# filesystem/ is entirely build output (sdcard images, u-boot.bin, work symlink)
/filesystem/

# Leftover bash history of the old (pos_sol.25-era) docker workflow. The
# build container (docker/build-env, driven by scripts/dbuild.sh) keeps no
# history file in the tree.
/.docker_history

# Junk / build backups
*.deb
*.back
# .backup is a distinct suffix from .back: the rootfs pipeline leaves
# board/<plat>/rootfs.cpio.backup behind on every build.
*.backup
# The rootfs.cpio published by the CI (or copied from a local buildroot
# build) is dropped here by hand; committing it would ship a binary and
# start the rootfs pipeline, whose build then skips buildroot and fails.
/build/meta-rootfs/recipes-rootfs/linux/files/board/*/rootfs.cpio
# patch/quilt reject & backup files (e.g. do_updiff regeneration leftovers)
*.orig
*.rej
# do_attach_infrabase dirty-tree guard manifests (sibling of each attached
# component tree, e.g. avz.attach.sha256, u-boot.attach.sha256), and the
# marker naming the recipe each tree belongs to (u-boot.attach.pf).
*.attach.sha256
*.attach.pf
__pycache__/
/scripts.old/

# smoldtb, a third-party device-tree reader cloned under prof/ci for local
# experiments: it carries its own .git (adding it would nest a repository) and
# its build products. Kept on disk, out of the repository — make it a submodule
# or a fetched component if it ever needs to be shared.
/prof/ci/smoldtb/
