--- /dev/null
+++ ./configs/virt32_defconfig
@@ -0,0 +1,22 @@
+# Buildroot configuration for the virt32 (armv7, QEMU virt) platform — the
+# 32-bit twin of virt64_defconfig, kept MINIMAL on purpose: buildroot expands
+# it through Kconfig at `make virt32_defconfig`, so only the selections live
+# here, not the derived symbols.
+BR2_arm=y
+BR2_cortex_a15=y
+BR2_TOOLCHAIN_EXTERNAL=y
+BR2_TOOLCHAIN_EXTERNAL_ARM_ARM=y
+BR2_INIT_SYSV=y
+BR2_SYSTEM_BIN_SH_BASH=y
+BR2_SYSTEM_DHCP="eth0"
+BR2_ROOTFS_OVERLAY="$(BASE_DIR)/board/common/rootfs_overlay/ $(BASE_DIR)/board/virt32/rootfs_overlay/"
+BR2_ROOTFS_POST_BUILD_SCRIPT="${BASE_DIR}/board/common/post_build.sh"
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BASE_DIR)/board/virt32/post_image.sh"
+# BR2_TARGET_GENERIC_GETTY is not set
+BR2_PACKAGE_AUTO_GETTY_SUPPORT=y
+BR2_PACKAGE_AUTO_GETTY=y
+BR2_PACKAGE_AUTO_GETTY_ROOT_LOGIN=y
+BR2_PACKAGE_UTIL_LINUX=y
+BR2_PACKAGE_UTIL_LINUX_AGETTY=y
+BR2_TARGET_ROOTFS_CPIO=y
+BR2_TARGET_ROOTFS_CPIO_FULL=y
