--- a/cmd/enable_irq.c
+++ b/cmd/enable_irq.c
@@ -0,0 +1,94 @@
+#include <common.h>
+#include <command.h>
+#include <asm/io.h>                 /* readl / writel / writew */
+#include <asm/gic.h>                /* offsets GICD_* / GICC_* */
+#include <asm/proc-armv/system.h>   /* local_irq_enable() */
+
+#define GICD_BASE       0x08000000  /* distributeur */
+#define GICC_BASE       0x08010000  /* interface CPU */
+
+#define VEXT_BASE       0x08804000
+#define VEXT_IRQ_CTRL   (VEXT_BASE + 0x18)
+#define VEXT_IRQ_EN     0x80
+#define VEXT_IRQ_CLEAR  0x01
+
+#define VEXT_LED_REG		(VEXT_BASE + 0x3A)
+#define VEXT_IRQ_STATUS		0x10
+#define VEXT_IRQ_BUTTON(r)	(((r) >> 1) & 0x7)	/* bits 3:1 */
+#define GIC_SPURIOUS		1020			/* IDs >= 1020 : pas d'IRQ valide */
+
+#define VEXT_IRQN       (13 + 32)   /* irqmap[VIRT_VEXT] + 32 (SPI) = 45 */
+
+static void gic_init_vext(void)
+{
+	/* 1.1 Affinité CPU0 : 1 octet par IRQ, 4 IRQ par registre */
+	writel(0x01010101, GICD_BASE + GICD_ITARGETSRn + 4 * (VEXT_IRQN / 4));
+
+	/* 1.2 Distributeur : activation globale */
+	writel(0x1, GICD_BASE + GICD_CTLR);
+
+	/* 1.3 Interface CPU : activation */
+	writel(0x1, GICC_BASE + GICC_CTLR);
+
+	/* 1.4 Priorités : ne rien masquer */
+	writel(0xFF, GICC_BASE + GICC_PMR);
+
+	/* 1.5 Démasquer l'IRQ 45 : 1 bit par IRQ, 32 IRQ par registre */
+	writel(1 << (VEXT_IRQN % 32),
+	       GICD_BASE + GICD_ISENABLERn + 4 * (VEXT_IRQN / 32));
+
+	/* 1.6 vExt : enable + clear d'une éventuelle IRQ restée en attente */
+	writew(VEXT_IRQ_EN | VEXT_IRQ_CLEAR, VEXT_IRQ_CTRL);
+
+	/* 1.7 CPU : autoriser les IRQ (bit I du CPSR à 0) */
+	local_irq_enable();
+}
+
+static int do_enable_irq(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	gic_init_vext();
+	printf("GIC initialise, IRQ %d (vExt) activee\n", VEXT_IRQN);
+	return 0;
+}
+
+U_BOOT_CMD(
+	enable_irq, 1, 0, do_enable_irq,
+	"init GIC + IRQ vExt (switches)",
+	""
+);
+
+
+
+// 4.5.3 HANDLE IRQ
+
+void handle_irq(void)
+{
+	u32 iar, irqn;
+
+	while (1) {
+		/* 2.1 Lire ICCIAR = acquittement côté GIC */
+		iar  = readl(GICC_BASE + GICC_IAR);
+		irqn = iar & 0x3FF;
+
+		if (irqn >= GIC_SPURIOUS)	/* plus rien en attente */
+			break;
+
+		if (irqn == VEXT_IRQN) {
+			u16 ctrl = readw(VEXT_IRQ_CTRL);
+			u8  sw   = VEXT_IRQ_BUTTON(ctrl);	/* lire AVANT le clear */
+
+			/* 2.2 Inverser la LED : SWn -> LED(n-1) */
+			if ((ctrl & VEXT_IRQ_STATUS) && sw >= 1 && sw <= 5) {
+				u16 leds = readw(VEXT_LED_REG);
+				writew(leds ^ (1 << (sw - 1)), VEXT_LED_REG);
+				printf("IRQ %u : switch %u\n", irqn, sw);	/* debug, optionnel */
+			}
+
+			/* Acquitter vExt : baisse la ligne en gardant IRQ_ENABLE */
+			writew(VEXT_IRQ_EN | VEXT_IRQ_CLEAR, VEXT_IRQ_CTRL);
+		}
+
+		/* 2.3 End-of-Interrupt */
+		writel(iar, GICC_BASE + GICC_EOIR);
+	}
+}
\ No newline at end of file
