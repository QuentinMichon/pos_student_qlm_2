--- a/arch/arm64/boot/dts/arm/virt64.dts
+++ b/arch/arm64/boot/dts/arm/virt64.dts
@@ -386,4 +386,22 @@
 		compatible = "fixed-clock";
 	};
 
+	/*
+	 * The vext teaching device, emulated by the patched QEMU (hw/arm/vext,
+	 * VIRT_VEXT at 0x08804000, SPI 13). QEMU generates this device tree for
+	 * the virt machine but knows nothing of vext, so the node is added here.
+	 *
+	 * platform_type tells the driver which half to take: "virt" is the MMIO
+	 * path, "rpi4" drives the Sense HAT through rpisense instead.
+	 *
+	 * interrupt-parent is the raw phandle of intc@8000000, not <&gic>: this
+	 * file is a dump of QEMU's generated DTB and carries no labels.
+	 */
+	vext@8804000 {
+		compatible = "virt64,vext";
+		reg = <0x00 0x8804000 0x00 0x1000>;
+		interrupt-parent = <0x8001>;
+		interrupts = <0x00 0x0d 0x04>;
+		platform_type = "virt";
+	};
 };
