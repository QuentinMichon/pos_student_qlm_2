--- a/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
+++ b/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
@@ -19,11 +19,12 @@
 	compatible = "raspberrypi,4-model-b", "brcm,bcm2711";
 	model = "Raspberry Pi 4 Model B";
 
+#if 0
 	chosen {
 		/* 8250 auxiliary UART instead of pl011 */
 		stdout-path = "serial1:115200n8";
 	};
-
+#endif
 	cam1_reg: regulator-cam1 {
 		compatible = "regulator-fixed";
 		regulator-name = "cam1-reg";
@@ -508,3 +509,24 @@
 		eth_led1 = <&phy1>,"led-modes:4";
 	};
 };
+
+/*
+ * This kernel boots with the fork-built dtb embedded in the FIT image, which
+ * the firmware never touches: its dtparam overlays cannot enable i2c1 (the
+ * Sense HAT bus), and it never fills in the size of memory@0.
+ */
+&i2c1 {
+	status = "okay";
+};
+
+/ {
+	/*
+	 * Left at the dtsi's zero size, the kernel finds no usable RAM and dies
+	 * early. 948 MiB stays below the VideoCore split of the smallest (1 GiB)
+	 * Pi 4. Three cells: the root is #address-cells = <2>, #size-cells = <1>.
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x3b400000>;
+	};
+};
