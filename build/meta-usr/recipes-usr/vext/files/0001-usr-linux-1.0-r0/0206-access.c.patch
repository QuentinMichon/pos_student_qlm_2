+static int vext_probe(struct platform_device *pdev)
+{
+
+// ========================= VIRT32 ===========================================================
+# if 1
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;	/* nœud qui a matché */
+	struct vext_priv *priv;
+	const char *type;
+	int ret, i;
+
+	if(np == NULL) {
+		return dev_err_probe(dev, -ENODEV, "aucun noeud device-tree\n");
+	}
+
+	if (of_property_read_string(np, "platform_type", &type)) {
+		return dev_err_probe(dev, -EINVAL, "propriete 'platform_type' absente\n");
+	}
+
+	/* 1. structure privée */
+	// allocation mémoire pour la structure privée (représente le device Vext)
+	
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+
+	if(priv == NULL) {
+		return -ENOMEM;
+	}
+
+	priv->dev = dev;
+	platform_set_drvdata(pdev, priv);
+
+	
+	/* 2. registres vExt */
+	// lit la propriété 'reg' du nœud (index 0) et fait l'ioremap
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	
+	if(IS_ERR(priv->base)) {
+		return dev_err_probe(dev, PTR_ERR(priv->base), 
+			"ressource 'reg' absente ou ioremap impossible\n");
+	}
+
+	
+	/* 3. verrou AVANT tout ce qui peut appeler led_set ou l'ISR */
+	spin_lock_init(&priv->lock);
+
+	/* état initial matériel : LED0, LED2, LED4 allumées */
+	iowrite16(VEXT_LEDS_024, priv->base + VEXT_LED_OFFSET);
+
+	
+	/* 4. une entrée de classe LED par LED */
+	for (i = 0; i < VEXT_NB_LEDS; i++) {
+		struct vext_led *led = &priv->leds[i];
+
+		led->idx  = i;
+		led->priv = priv;
+
+		led->cdev.name = devm_kasprintf(dev, GFP_KERNEL, "vext_led%d", i);
+		
+		if (led->cdev.name == NULL) {
+			return -ENOMEM;
+		}
+
+		led->cdev.max_brightness = 1;
+		led->cdev.brightness_set = led_set;		// callback set
+
+		/* sysfs cohérent avec l'état initial écrit ci-dessus */
+		led->cdev.brightness = (VEXT_LEDS_024 & (1 << i)) ? 1 : 0;
+
+		ret = devm_led_classdev_register(dev, &led->cdev);
+
+		if (ret) {
+			return dev_err_probe(dev, ret,
+				"enregistrement de %s impossible\n", led->cdev.name);
+		}
+	}
+
+
+	/* 5. interruption */
+	priv->irq = platform_get_irq(pdev, 0);	// numéro Linux, pas 45
+
+	if (priv->irq < 0) {
+		return priv->irq;
+	}
+
+	ret = devm_request_irq(dev, priv->irq, switch_isr, IRQF_TRIGGER_HIGH, "vext", priv);
+
+	if (ret) {
+		return dev_err_probe(dev, ret, "request_irq impossible\n");
+	}	
+
+
+	/* 6. activer l'IRQ côté vExt, APRÈS avoir installé le handler */
+	/* activer l'IRQ côté vExt (+ clear d'une éventuelle IRQ en attente),
+	 * APRÈS avoir installé le handler */
+	iowrite16(VEXT_IRQ_EN | VEXT_IRQ_CLEAR, priv->base + VEXT_IRQ_CTRL_OFFSET);
+
+	dev_info(dev, "[%s] probe OK (%pOF) : LED0-LED2-LED4 allumees\n",type, np);
+#endif
+
+// ========================= RPI4 ===========================================================
+#if 0
+	struct device *dev = &pdev->dev;
+	struct vext_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	ret = rpisense_init(&priv->sense);		/* client I2C 0x46 + thread joystick */
+	if (ret)
+		return dev_err_probe(dev, ret, "rpisense_init a echoue\n");
+
+	platform_set_drvdata(pdev, priv);
+
+	rpisense_display_led(&priv->sense, 0, true);
+	rpisense_display_led(&priv->sense, 2, true);
+	rpisense_display_led(&priv->sense, 4, true);
+
+	dev_info(dev, "probe rpi4 OK : LED0-LED2-LED4 allumees\n");
+#endif
+
+	return 0;
+}
+
+static void vext_remove(struct platform_device *pdev)
+{
+	struct vext_priv *priv = platform_get_drvdata(pdev);
+
+#ifdef RPI_TARGET
+	rpisense_display_led(&priv->sense, 0, false);
+	rpisense_display_led(&priv->sense, 2, false);
+	rpisense_display_led(&priv->sense, 4, false);
+	rpisense_remove(&priv->sense);		/* stoppe le thread + libère le client I2C */
+#else
+	iowrite16(VEXT_IRQ_CLEAR, priv->base + VEXT_IRQ_CTRL_OFFSET);
+	iowrite16(0, priv->base + VEXT_LED_OFFSET);
+#endif
+	dev_info(&pdev->dev, "remove : LEDs eteintes\n");
+}
+
+
+
+static const struct of_device_id vext_of_match[] = {
+	{ .compatible = "virt32,vext" },
+	{ .compatible = "rpi4,vext" },
+	{ /* sentinelle */ }
+};
+
+MODULE_DEVICE_TABLE(of, vext_of_match);
+
+static struct platform_driver vext_driver = {
+	.probe  = vext_probe,
+	.remove = vext_remove,
+	.driver = {
+		.name           = "vext",
+		.of_match_table = vext_of_match,
+	},
+};
+
+static int __init access_init(void)
+{
+	return platform_driver_register(&vext_driver);
+}
+
+static void __exit access_exit(void)
+{
+	platform_driver_unregister(&vext_driver);
+}
+
+module_init(access_init);
+module_exit(access_exit);
+
