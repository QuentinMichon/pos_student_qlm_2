+#define VEXT_NB_LEDS	5
+
+/*
+ * The Sense HAT path needs <linux/mfd/rpisense/core.h>, which only the
+ * Raspberry Pi kernel fork carries — a vanilla kernel (virt32/virt64) has no
+ * such MFD. Gate it so the module still builds there, MMIO-only; the Makefile
+ * defines VEXT_RPISENSE on the rpi4 platforms. Same shape as SO3's vext.c,
+ * whose rpi4 path sits behind CONFIG_RPI_SENSE.
+ */
+#ifdef VEXT_RPISENSE
+#include "rpisense.h"
+#endif
+
+
+#define VEXT_LED_OFFSET			0x3A
+#define VEXT_LEDS_024		((1 << 0) | (1 << 2) | (1 << 4))	/* 0x15 */
+
+#define VEXT_IRQ_CTRL_OFFSET	0x18
+#define VEXT_IRQ_EN				0x80
+#define VEXT_IRQ_STATUS			0x10
+#define VEXT_IRQ_CLEAR			0x01
+#define VEXT_IRQ_BUTTON(r)	(((r) >> 1) & 0x7)	/* bits 3:1 */
+
+struct vext_priv;				/* déclaration anticipée */
+
+// structure privée par LED FRAMEWORK généré 
+struct vext_led {
+    struct led_classdev cdev;   // embarquée, pas un pointeur (container_of)
+    struct vext_priv *priv;     // remonter au device
+    int idx;                    // numéro de la LED (0..4)
+};
+
+// structure privée au DRIVER
+struct vext_priv {
+	void __iomem *base;
+	struct device *dev;
+	int irq;
+#ifdef RPI_TARGET
+	struct rpisense_data sense;
+#endif
+	spinlock_t lock;			/* protège le RMW du registre LED */	
+	struct vext_led leds[VEXT_NB_LEDS];
+};
+
+
+/*
+ * Driver Linux du peripherique vExt (labo 02/06/07)
+ *
+ * Squelette : seules les signatures sont fournies. Les types, structures
+ * d'etat et enregistrements sont a reconstruire, en plus des corps.
+ *
+ * Le chemin Sense HAT (rpi4) est compile sous VEXT_RPISENSE.
+ */
+
+static irqreturn_t process_input(int irq, void *dev_id)
+{
+	/* A completer (POS) */
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t switch_isr(int irq, void *dev_id)
+{
+	struct vext_priv *priv = dev_id;
+	u16 ctrl = ioread16(priv->base + VEXT_IRQ_CTRL_OFFSET);
+	u8 sw;
+
+	if (!(ctrl & VEXT_IRQ_STATUS))
+		return IRQ_NONE;			/* pas pour nous */
+
+	sw = VEXT_IRQ_BUTTON(ctrl);		/* lire AVANT le clear */
+
+	if (sw >= 1 && sw <= VEXT_NB_LEDS) {
+		u16 leds;
+		
+		spin_lock(&priv->lock);
+
+		leds = ioread16(priv->base + VEXT_LED_OFFSET) ^ (1 << (sw - 1)) ;
+		iowrite16(leds, priv->base + VEXT_LED_OFFSET);
+
+		/* garder le sysfs cohérent avec le registre */
+		priv->leds[sw - 1].cdev.brightness = (leds & (1 << (sw - 1))) ? 1 : 0;
+
+		spin_unlock(&priv->lock);
+	}
+
+	/* acquitter : baisse la ligne en gardant IRQ_ENABLE (sinon ton
+	 * vext_write QEMU désactive les IRQ, bit 7 relu à chaque écriture) */
+	iowrite16(VEXT_IRQ_EN | VEXT_IRQ_CLEAR, priv->base + VEXT_IRQ_CTRL_OFFSET);
+
+	dev_info(priv->dev, "switch %u presse\n", sw);
+
+	return IRQ_HANDLED;
+}
+
+static void led_set(struct led_classdev *led_cdev, enum led_brightness brightness)
+{
+	struct vext_led *led = container_of(led_cdev, struct vext_led, cdev);
+	struct vext_priv *priv = led->priv;
+	
+	unsigned long flags;
+	u16 leds;
+
+	/* zone critique */
+	spin_lock_irqsave(&priv->lock, flags);
+
+	leds = ioread16(priv->base + VEXT_LED_OFFSET);
+
+	if(brightness) {	// LED ON
+		leds |= 0b1 << led->idx; 
+	} else {			// LED OFF
+		leds &= ~( 0b1 << led->idx );
+	}
+
+	iowrite16(leds, priv->base + VEXT_LED_OFFSET);
+
+	spin_unlock_irqrestore(&priv->lock, flags);
+	/* end zone critique */
+}
