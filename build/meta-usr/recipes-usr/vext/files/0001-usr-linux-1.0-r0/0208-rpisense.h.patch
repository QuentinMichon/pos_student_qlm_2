+ * Copyright (c) 2020-2026 HEIG-VD, REDS Institute
+ *******************************************************************/
+
+#ifndef RPISENSE_H
+#define RPISENSE_H
+
+#include <linux/types.h>
+#include <linux/i2c.h>
+#include <linux/platform_device.h>
+
+typedef void (*joystick_handler_t)(struct platform_device *pdev, int key);
+
+#define UP 0x04
+#define DOWN 0x01
+#define RIGHT 0x02
+#define LEFT 0x10
+#define CENTER 0x08
+
+/* 8 (row) * 8 (column) * 3 (colors) + 1 (first byte needed blank) */
+#define SIZE_FB 193
+
+/* Data used by rpisense for internal handling */
+struct rpisense_data {
+	joystick_handler_t joystick_handler;
+	struct platform_device *pdev;
+	struct task_struct *joystick_thread;
+
+	/*
+	 * Our own dummy i2c client at 0x46 on i2c-1. The old rpisense MFD
+	 * (<linux/mfd/rpisense/core.h>) is gone from the modern Raspberry Pi
+	 * kernels, so this backend talks to the HAT directly.
+	 */
+	struct i2c_client *client;
+
+	unsigned char matrix[SIZE_FB];
+};
+
+int rpisense_init(struct rpisense_data *sense_data);
+void rpisense_remove(struct rpisense_data *sense_data);
+int rpisense_joystick_handler_register(struct rpisense_data *sense_data, struct platform_device *pdev,
+				       joystick_handler_t joystick_handler);
+void rpisense_display_led(struct rpisense_data *sense_data, int led_nr, bool on);
+
+#endif /* RPISENSE_H */
